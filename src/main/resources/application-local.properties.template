# Zoho SMTP email. MAIL_PASSWORD must be a Zoho app-specific password.
MAIL_HOST=smtp.zoho.in
MAIL_PORT=587
MAIL_USERNAME=customersupport@vettrihrms.in
ZOHO_MAIL_APP_PASSWORD=
MAIL_PASSWORD=
MAIL_FROM=customersupport@vettrihrms.in
